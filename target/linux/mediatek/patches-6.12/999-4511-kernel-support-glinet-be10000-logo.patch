Index: linux-6.12.94/drivers/staging/fbtft/fbtft-core.c
===================================================================
--- linux-6.12.94.orig/drivers/staging/fbtft/fbtft-core.c
+++ linux-6.12.94/drivers/staging/fbtft/fbtft-core.c
@@ -818,6 +818,7 @@ int fbtft_register_framebuffer(struct fb
 
